{
    "name": "popov/datagrid-bundle",
    "description": "This bundle allows you to integrate ZfcDatagrid into your Symfony project",
    "keywords": [],
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Serhii Popov",
            "email": "popow.serhii@gmail.com"
        }
    ],
    "repositories": [
      {
        "type": "vcs",
        "url": "https://github.com/popovserhii/zfc-datagrid.git"
      }
    ],
    "require": {
        "doctrine/orm": "~2.4",
        "symfony/framework-bundle": "~4.0|~5.0|~7.0|~8.0",
        "nyholm/psr7": "~1.2.1",
        "symfony/psr-http-message-bridge": "~2.1",
        "symfony/console": "~4.0|~5.0",
        "symfony/process": "~4.0|~5.0",
        "symfony/yaml": "~4.0|~5.0",
        "laminas/laminas-serializer": "2.11.x-dev",
        "laminas/laminas-db": "^2.14",
        "zfc-datagrid/zfc-datagrid": "dev-symfony-v0.4.4"
    },
    "require-dev": {
        "symfony/doctrine-bridge": "~4.0|~5.0",
        "symfony/phpunit-bridge": "^3.3",
        "phpunit/phpunit": "^9.6",
        "mockery/mockery": "^1.6",
        "doctrine/sql-formatter": "^1.3"
    },
    "autoload": {
        "psr-4": {
          "Popov\\DatagridBundle\\": "src/"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Popov\\DatagridBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist"
    },
    "minimum-stability": "dev"
}
